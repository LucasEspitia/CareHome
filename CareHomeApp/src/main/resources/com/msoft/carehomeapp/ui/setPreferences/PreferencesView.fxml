<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>

<VBox alignment="CENTER" spacing="20"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.msoft.carehomeapp.ui.controllers.setPreferences.PreferencesController"
      prefWidth="480" prefHeight="600">

    <!-- TITLE -->
    <Label text="Preferences" style="-fx-font-size: 24; -fx-font-weight: bold;" />

    <!-- EMOTION -->
    <HBox spacing="12" alignment="CENTER">
        <Label text="Emotion:" style="-fx-font-size: 14;" />
        <ComboBox fx:id="comboEmotion" prefWidth="180"/>
    </HBox>

    <!-- SONGS SECTION -->
    <VBox spacing="12" alignment="CENTER">
        <Label text="Songs" style="-fx-font-size: 18; -fx-font-weight: bold;" />

        <VBox spacing="6" alignment="CENTER">
            <Label text="Song 1"/>
            <HBox spacing="10" alignment="CENTER">
                <TextField fx:id="fieldSong1Title" promptText="Title" prefWidth="160"/>
                <TextField fx:id="fieldSong1Artist" promptText="Artist" prefWidth="160"/>
            </HBox>
        </VBox>

        <VBox spacing="6" alignment="CENTER">
            <Label text="Song 2"/>
            <HBox spacing="10" alignment="CENTER">
                <TextField fx:id="fieldSong2Title" promptText="Title" prefWidth="160"/>
                <TextField fx:id="fieldSong2Artist" promptText="Artist" prefWidth="160"/>
            </HBox>
        </VBox>

        <VBox spacing="6" alignment="CENTER">
            <Label text="Song 3"/>
            <HBox spacing="10" alignment="CENTER">
                <TextField fx:id="fieldSong3Title" promptText="Title" prefWidth="160"/>
                <TextField fx:id="fieldSong3Artist" promptText="Artist" prefWidth="160"/>
            </HBox>
        </VBox>
    </VBox>

    <!-- LIGHTS -->
    <VBox spacing="6" alignment="CENTER">
        <Label text="Lights Preference" />
        <ComboBox fx:id="comboLights" prefWidth="200"/>
    </VBox>

    <!-- BUTTONS -->
    <HBox spacing="20" alignment="CENTER">
        <Button fx:id="btnBack" text="Back" prefWidth="120"/>
        <Button fx:id="btnSave" text="Save" prefWidth="120"/>
    </HBox>

</VBox>
